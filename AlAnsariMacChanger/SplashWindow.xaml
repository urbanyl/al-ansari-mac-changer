<Window x:Class="AlAnsariMacChanger.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Al-Ansari MAC Changer"
        Width="520" Height="330"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static SystemColors.ControlBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Border BorderBrush="{x:Static SystemColors.ActiveBorderBrush}" BorderThickness="1">
        <Grid Margin="26,20,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Viewbox Width="46" Height="46" Stretch="Uniform">
                    <Grid Width="256" Height="256">
                        <Rectangle Width="256" Height="256" Fill="#1A2BE8" />
                        <Path Data="M 46,46 L 210,46 L 210,210 L 46,210 L 46,102 L 159,102 L 159,159 L 102,159"
                              Stroke="White"
                              StrokeThickness="25.6"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              StrokeLineJoin="Miter" />
                    </Grid>
                </Viewbox>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Al-Ansari MAC Changer" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="MAC address and system identity changer"
                               FontSize="11"
                               Foreground="{x:Static SystemColors.GrayTextBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
                           FontFamily="Traditional Arabic, Segoe UI, Tahoma"
                           FontSize="32"
                           FlowDirection="RightToLeft"
                           TextAlignment="Center"
                           Margin="0,4,0,0" />
                <TextBlock Text="In the name of Allah, the Most Gracious, the Most Merciful"
                           FontSize="11"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <ProgressBar x:Name="LoadingBar"
                         Grid.Row="2"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Margin="0,10,0,0" />

            <TextBlock x:Name="LoadingText"
                       Grid.Row="3"
                       Text="Loading…"
                       FontSize="11"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       Margin="0,8,0,0" />

            <TextBlock Grid.Row="4"
                       Text="Version 1.0"
                       FontSize="10"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,10,0,0" />
        </Grid>
    </Border>
</Window>
